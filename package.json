    "@turf/bbox-polygon": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/luxon": "^3.7.4",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "colord": "^2.9.3",
    "dompurify": "^3.4.13",
    "fathom-client": "^3.7.2",
    "framer-motion": "^11.18.2",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "luxon": "^3.7.2",
    "mapbox-gl": "^3.28.1",
    "react": "^18.3.1",
    "react-circle-flags": "^0.0.23",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^5.0.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.85.0",
    "react-i18next": "^15.7.4",
    "react-map-gl": "^7.1.9",
    "react-responsive": "^10.0.1",
    "react-router": "^7.18.2",
    "react-share": "^5.3.0",
    "schema-dts": "^1.1.5",
    "swiper": "^12.2.0",
    "tailwind-variants": "0.1.20",
    "tailwindcss": "3.4.3",
    "vaul": "1.1.2",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
