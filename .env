# SahajCloud API origin (the widget appends `/api`). Override in .env.local for
# local backend development, e.g. VITE_SAHAJCLOUD_URL="http://localhost:3000".
VITE_SAHAJCLOUD_URL="https://cloud.sydevelopers.com"
VITE_HOST="http://localhost:5173"

# Sentry DSN for automatic error reporting. Intentionally NOT set here, and not a
# secret either — a DSN is write-only and ships in every client bundle. The reason it
# stays out of the repo is noise: committed, every fork, every preview deploy and every
# `pnpm dev` would post into the production project. Set it per-environment in the
# Cloudflare Pages dashboard. Unset, the widget logs failures to the console exactly as
# it did before and never fetches the SDK. See .claude/docs/environment.md.
# VITE_SENTRY_DSN=""
#
# Source-map upload (#130) is switched on by SENTRY_AUTH_TOKEN + SENTRY_ORG +
# SENTRY_PROJECT, which are BUILD-TIME only and so carry no VITE_ prefix — the token is a
# real secret and must never reach the bundle. They are not set here and never should be:
# unset, no maps are emitted at all and the build is byte-identical to one from before
# #130. Set them on the `sahajatlas` Pages project only; the runbook is in
# .claude/docs/environment.md.

# Cloudflare Turnstile site key for the report-issue form. A SITE key is public by
# design (the secret half lives in SahajCloud), so it belongs here rather than in
# .env.local. This is Cloudflare's always-passes TEST key — dev, Ladle and CI use it;
# production overrides it with the real key in the Cloudflare Pages environment.
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
