{
  // This file type-checks the files the app tsconfig excludes.
  // The app tsconfig includes only "src" and ".ladle".
  // This file covers the smoke specs and the build and CI scripts.
  // Co-located unit specs live under src/. The app project already checks them.
  // `pnpm typecheck` runs this file as its second step. See package.json.
  //
  // allowJs and checkJs also check the .mjs scripts.
  // noImplicitAny is off because these node utilities are untyped on purpose.
  // A type annotation on every callback parameter adds noise. It does not
  // catch real bugs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false
  },
  "include": ["tests", "scripts", "vitest.config.ts", "vitest.smoke.config.ts"]
}
