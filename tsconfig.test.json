{
  // This file type-checks the files the app tsconfig excludes.
  // The app tsconfig takes "src" and the `.ladle/*` files but `.ladle/vite.config.ts`.
  // `scripts/typecheck-coverage.test.ts` holds that every tracked TypeScript file is in one project.
  // This file covers the smoke and browser-lane specs, the build and CI scripts, and the Vite
  // and vitest configs.
  // Co-located unit specs live under src/. The app project already checks them.
  // `pnpm typecheck` runs this file as its second step. See package.json.
  // `src/vite-env.d.ts` is here for `import.meta.env`, which `src/` modules the browser lane
  // imports read.
  //
  // Both Vite configs are checked here and nowhere else: they import plugins from
  // scripts/*.mjs, which only a project with allowJs can type.
  //
  // allowJs and checkJs also check the .mjs scripts.
  // noImplicitAny is off because these node utilities are untyped on purpose.
  // A type annotation on every callback parameter adds noise. It does not
  // catch real bugs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "noImplicitAny": false
  },
  "include": [
    "tests",
    "scripts",
    "worker",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.smoke.config.ts",
    ".ladle/vite.config.ts",
    "playwright.config.ts",
    "src/vite-env.d.ts"
  ],
  // The app tsconfig's `exclude` would otherwise carry over and drop `.ladle/vite.config.ts`.
  "exclude": []
}
