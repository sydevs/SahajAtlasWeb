{
  // The atlas app, as a Cloudflare Workers static-assets Worker. It serves `sahajatlas.com` as a
  // Custom Domain since #283. `docs/rules/deployment.md` is the one place that topology is stated.
  //
  // ⚠ This `name` must equal the Worker's name in the Cloudflare dashboard, which owns it: a
  // `versions upload` against any other name fails on "a Worker that does not yet exist", so a
  // dashboard rename reaches every PR's smoke job until this file follows it (#266). It is also
  // the anchor both deploy checks read (#282).
  //   - A preview host is `<preview>-<worker>.<subdomain>.workers.dev`, so the smoke lane anchors
  //     the whole `-sahajatlas-web` LABEL segment, never a substring: a Worker whose name EXTENDS
  //     this one passes a substring or an unanchored regex, and this repo already builds a second
  //     Worker. `scripts/assert-preview-host.mjs` is that check.
  //   - `production-smoke.yml` compares the WHOLE check-run name, `Workers Builds: <name>`,
  //     with `==`, which is what keeps the playground's deploy out of the production lane.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahajatlas-web",

  "compatibility_date": "2026-10-06",

  // One small script, for the visitor's approximate location (`worker/index.ts`). It runs only
  // where `run_worker_first` names a path; every other file is served as a free static asset,
  // never through it.
  // ⚠ `public/_headers` does not reach a response the script builds, so it sets the site-wide
  // CORS and `noindex` itself. `docs/rules/deployment.md` owns the topology.
  "main": "worker/index.ts",

  // `pnpm build` writes `dist/` and copies `public/` into it, which is how the shared
  // `_headers` and `robots.txt` reach this Worker. `not_found_handling` does the job the
  // `public/_redirects` splat did on Pages, until #283 deleted the file.
  //
  // ⚠ Build this Worker with **`pnpm build:worker`**, never `pnpm build`. A Worker reads
  // `_redirects` and its API rejects that splat as an infinite loop (100324), failing the
  // deploy. `build:worker` is `build` plus the `rm -f`, a dormant guard against the file
  // returning (#280, #283). #252 planned to bring it back with a `/map  /  301` rule a Worker
  // accepts, then withdrew that step and closed: the legacy forward already drops `/map`.
  // `check:wrangler` cannot catch a regression here — the dry run never reaches the API — so
  // `scripts/wrangler-config.test.ts` pins the pairing instead.
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The per-visitor location module, and nothing else: every embed and the standalone page
    // import it, and every other file stays a static asset.
    "run_worker_first": ["/geo.js"]
  },

  // Not the default — wrangler's own schema says `false`.
  "preview_urls": true,

  // Empty on purpose; `cloudflare/wrangler-action` throws without the block
  // (sydevs/SahajCloud#903). `wrangler.design.jsonc` carries what it is pre-placed for.
  "previews": {}
}
