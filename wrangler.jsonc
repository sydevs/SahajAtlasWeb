{
  // The `sahajatlas` app, as a Cloudflare Workers static-assets Worker. Through #280 the
  // `sahajatlas` Cloudflare **Pages** project still serves `sahajatlas.com` from this same
  // `dist/`, and #266's last child is what moves the domain. `AGENTS.md` § Deployment is the
  // one place that topology is stated.
  //
  // ⚠ `sahajatlas` is a PREFIX of `sahajatlas-design`, and a preview host is
  // `<preview>-<worker>.<subdomain>.workers.dev`, so a check telling the two deploys apart must
  // anchor `-sahajatlas.<subdomain>.workers.dev`, never the bare substring
  // (`scripts/get-cloudflare-preview-url.test.ts` pins that boundary for today's Pages shape).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahajatlas",

  // Required even with no `main`. This is the date wrangler 4.150.0 suggests.
  "compatibility_date": "2026-10-06",

  // `pnpm build` writes `dist/` and copies `public/` into it, which is how the shared
  // `_headers` and `robots.txt` reach this Worker. `not_found_handling` replaces the
  // `public/_redirects` splat, which a Worker never reads.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },

  // Not the default — wrangler's own schema says `false`.
  "preview_urls": true,

  // Empty on purpose; `cloudflare/wrangler-action` throws without the block
  // (sydevs/SahajCloud#903). `wrangler.design.jsonc` carries what it is pre-placed for.
  "previews": {}
}
