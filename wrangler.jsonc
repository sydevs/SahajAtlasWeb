{
  // The `sahajatlas` app, as a Cloudflare Workers static-assets Worker. It serves
  // `sahajatlas.com` as a Custom Domain since #283, which moved the domain off the Cloudflare
  // **Pages** project of the same name and deleted it. `docs/rules/deployment.md` is the one
  // place that topology is stated.
  //
  // ⚠ This name collides twice, and this `name` is the anchor both checks read (#282):
  //   - `sahajatlas` is a PREFIX of `sahajatlas-design`, and a preview host is
  //     `<preview>-<worker>.<subdomain>.workers.dev`, so telling the two deploys apart means
  //     anchoring the whole `-sahajatlas` LABEL segment, never the bare substring.
  //     `scripts/assert-preview-host.mjs` is what the smoke lane refuses the playground with.
  //   - it was also the deleted Pages project's name, whose check run read
  //     `Cloudflare Pages: sahajatlas` against this Worker's `Workers Builds: sahajatlas`
  //     (#283). `production-smoke.yml` compares the WHOLE name with `==`, integration prefix
  //     included, which is what kept those two apart and what keeps the playground out.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahajatlas",

  // Required even with no `main`. This is the date wrangler 4.150.0 suggests.
  "compatibility_date": "2026-10-06",

  // `pnpm build` writes `dist/` and copies `public/` into it, which is how the shared
  // `_headers` and `robots.txt` reach this Worker. `not_found_handling` does the job the
  // `public/_redirects` splat did on Pages, until #283 deleted the file.
  //
  // ⚠ Build this Worker with **`pnpm build:worker`**, never `pnpm build`. A Worker reads
  // `_redirects` and its API rejects that splat as an infinite loop (100324), failing the
  // deploy. `build:worker` is `build` plus the `rm -f`, now a dormant guard against the file
  // returning — #252 plans to, with a `/map  /  301` rule a Worker accepts (#280, #283).
  // `check:wrangler` cannot catch a regression here — the dry run never reaches the API — so
  // `scripts/wrangler-config.test.ts` pins the pairing instead.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },

  // Not the default — wrangler's own schema says `false`.
  "preview_urls": true,

  // Empty on purpose; `cloudflare/wrangler-action` throws without the block
  // (sydevs/SahajCloud#903). `wrangler.design.jsonc` carries what it is pre-placed for.
  "previews": {}
}
