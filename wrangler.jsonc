{
  // The `sahajatlas` app, as a Cloudflare Workers static-assets Worker. Through #280 the
  // `sahajatlas` Cloudflare **Pages** project still serves `sahajatlas.com` from the same
  // `dist/`; this Worker is verified at its own `workers.dev` host, and #266's last child is
  // what moves the domain. `AGENTS.md` § Deployment is the one place that topology is stated.
  //
  // The bare default filename is the app's, and `wrangler.design.jsonc` carries the target it
  // deploys, so the two are tellable apart at a glance.
  //
  // ⚠ A preview host is `<preview>-<worker>.<subdomain>.workers.dev`, and `sahajatlas` is a
  // PREFIX of `sahajatlas-design`, so a check that tells this Worker's deploy from the
  // playground's must anchor on the whole worker-name label segment —
  // `-sahajatlas.<subdomain>.workers.dev`, never the bare substring `sahajatlas`.
  // `scripts/get-cloudflare-preview-url.test.ts` pins that boundary for today's Pages shape.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahajatlas",

  // Required even with no `main`. This is the date wrangler 4.150.0 suggests.
  "compatibility_date": "2026-10-06",

  // `pnpm build` writes `dist/`, and copies `public/` into it, which is how the shared
  // `_headers` and `robots.txt` reach this Worker. `not_found_handling` is what
  // `public/_redirects` does for the Pages app; the Worker never reads that file, so the
  // standalone build's deep links depend on this key alone here.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },

  // Not the default — wrangler's own schema says `false`. #266's preview-lane child reads its
  // own previews back, and a preview check that cannot be read is the silent green it exists
  // to close.
  "preview_urls": true,

  // Pre-placed for a consumer that does not exist here yet, and empty because a preview of
  // this Worker diverges from production in nothing. `cloudflare/wrangler-action` throws
  // without the block (sydevs/SahajCloud#903's Technical notes, `ensure-config.ts:167,212`)
  // and #266's preview-lane child is what introduces that Action — this Worker deploys through
  // Workers Builds, so nothing here reads it. Measured: `wrangler deploy --dry-run` is silent
  // either way, so do not go looking for a local failure it prevents.
  "previews": {}
}
